# Copy to .env and fill in. Never commit .env. See docs/DEVELOPMENT.md and docs/SECURITY.md.
# Values below are placeholders only.

# --- Database (Neon; local dev uses a personal `dev` branch) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Read-only role for the ranking engine (official data zone only) — TBD, see docs/DATABASE.md
RANKING_DATABASE_URL=

# --- Payload CMS ---
PAYLOAD_SECRET=

# --- Auth (Better Auth) — ADR-0006 ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Later stages (leave empty until the service is set up) ---
# Cloudflare R2 (files, raw import files, backups)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis (rate limits, AI budget, cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Resend (e-mail); empty = log e-mails to console in development
RESEND_API_KEY=
# Sentry
SENTRY_DSN=
# Stripe (stage 2, test mode only outside production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# AI provider (stage 2) — provider TBD, ADR pending
AI_PROVIDER=
AI_DAILY_BUDGET_PLN=
